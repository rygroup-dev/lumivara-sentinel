# ========= Lumivara Sentinel — config =========
# The installer (or `python -m lumivara.setup_wizard`) fills in the first three
# values for you. Everything else has tested defaults; edit and restart to change.

# --- Telegram (your own bot from @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Only this Telegram account can control the bot.
TELEGRAM_CHAT_ID=

# --- Game login: session cookie from a logged-in browser (see README) ---
LUMIVARA_COOKIE=

# --- Pacing: delay between in-game actions (seconds) + random jitter ---
ACTION_DELAY_MIN=0.45
ACTION_DELAY_JITTER=0.55
PING_INTERVAL=15

# --- Loop intervals (seconds) ---
QUEST_INTERVAL=90
STAT_INTERVAL=6
EQUIP_INTERVAL=120

# --- Stats: archer, swordman, thief, mage, acolyte and merchant have built-in
#     weights; this order is only the fallback for other classes ---
STAT_BUILD=dex,agi,vit,str,luk,int

# --- Healing: drink below this HP% while something is hitting you ---
POTION_HP_PERCENT=35

# --- Farm map ---
# auto = pick the field that fits your level; or pin one of:
# field, meadow, snow, desert, swamp, wildwood, dunes, glacier, caldera, moor, crystal, tempest, citadel
FARM_ZONE=auto
# only farm a map once you are this many levels above its minimum level
ZONE_MARGIN=15

# --- Town merchant run: sell monster loot, restock Red Potions / arrows / Return Scrolls ---
ENABLE_SELL=true
POTION_TARGET=40
# spend at most this % of your silver on potions per town visit
POTION_BUDGET_PCT=30
ARROW_MIN=1000

# sell looted Red Potions above this many (2 silver each)
POTION_KEEP=150

# --- What a map is judged on: silver = net silver/h first, exp = EXP/h first ---
FARM_GOAL=silver

# --- Player market (at the town broker): sell loot / refine stones / cards to
#     players when they pay more than the NPC after fees; buy cheap potions ---
ENABLE_MARKET=false
MARKET_SELL_CARDS=true
MARKET_REPRICE_HOURS=6
MARKET_EVERY_MIN=45

# --- Gold Exchange ---
# Every 10 min, turn silver above GOLD_RESERVE into gold at the best ask,
# but never above GOLD_MAX_PRICE silver per gold.
GOLD_AUTOBUY=false
GOLD_RESERVE=2000
GOLD_MAX_PRICE=8000
